<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_translucent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Title Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_qr_code"
            app:tint="@color/accent_color"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/qr_wallpaper_title"
            android:textColor="@color/accent_color"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/qr_wallpaper_desc"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- QR Code Card Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <ImageView
            android:id="@+id/ivQrCode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>

    <!-- Direct URL info -->
    <TextView
        android:id="@+id/tvServerUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textColor="@color/accent_color"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="http://192.168.1.45:8090" />

    <!-- Live Status Indicator -->
    <TextView
        android:id="@+id/tvQrStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_capsule_translucent"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:text="@string/qr_wallpaper_waiting"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <!-- Dismiss Button -->
    <Button
        android:id="@+id/btnQrClose"
        android:layout_width="160dp"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_quick_button_selector"
        android:focusable="true"
        android:text="@string/btn_close"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
