<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_translucent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_distance"
            app:tint="@color/accent_color"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="¿A qué distancia ves tu TV?"
            android:textColor="@color/accent_color"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Ajusta automáticamente el tamaño de fuentes, iconos del Dock y espaciado para tu comodidad visual sin perder nitidez."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Near Option -->
        <Button
            android:id="@+id/btnDistanceNear"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_selector"
            android:focusable="true"
            android:lineSpacingExtra="2dp"
            android:text="Cerca\n(1 - 2 metros)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Medium Option -->
        <Button
            android:id="@+id/btnDistanceMedium"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_selector"
            android:focusable="true"
            android:lineSpacingExtra="2dp"
            android:text="Media\n(2.5 - 3.5 m)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Far Option -->
        <Button
            android:id="@+id/btnDistanceFar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_selector"
            android:focusable="true"
            android:lineSpacingExtra="2dp"
            android:text="Lejos\n(4+ metros)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDistanceClose"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_quick_button_selector"
        android:focusable="true"
        android:text="@string/btn_close"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

</LinearLayout>
